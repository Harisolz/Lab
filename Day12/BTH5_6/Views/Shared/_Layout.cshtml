
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - QLSV </title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS riêng -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <div class="dashboard">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-brand">
                <div class="brand-logo">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div>
                    <div class="brand-title">Student Admin</div>
                    <div class="brand-subtitle">QLSV</div>
                </div>
            </div>

            <div class="sidebar-section">
                QUẢN LÝ SINH VIÊN
            </div>

            <nav class="sidebar-menu">

                <!-- Danh sách sinh viên -->
                <a asp-controller="Student"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-people-fill"></i>
                    <span>Danh sách sinh viên</span>
                </a>

                <!-- Thêm sinh viên -->
                <a asp-controller="Student"
                   asp-action="Create"
                   class="sidebar-link">
                    <i class="bi bi-person-plus-fill"></i>
                    <span>Thêm sinh viên</span>
                </a>

            </nav>

            <div class="sidebar-section">
                QUẢN LÝ NGƯỜI HỌC
            </div>

            <nav class="sidebar-menu">

                <!-- Danh sách người học -->
                <a asp-controller="Learner"
                   asp-action="Index"
                   class="sidebar-link">
                    <i class="bi bi-journal-text"></i>
                    <span>Danh sách người học</span>
                </a>

                <!-- Thêm người học -->
                <a asp-controller="Learner"
                   asp-action="Create"
                   class="sidebar-link">
                    <i class="bi bi-person-plus"></i>
                    <span>Thêm người học</span>
                </a>

            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-bottom-icon">
                    <i class="bi bi-database-check"></i>
                </div>

                
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="main-wrapper">

            <!-- TOPBAR -->
            <header class="topbar">

                <div>
                    <div class="topbar-heading">
                        Hệ thống quản lý đào tạo
                    </div>

                    <div class="topbar-description">
                        ASP.NET Core MVC · BTH5
                    </div>
                </div>

                <div class="topbar-user">
                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="user-info">
                        <strong>Administrator</strong>
                        <small>Quản trị viên</small>
                    </div>
                </div>

            </header>

            <!-- PAGE -->
            <main class="main-content">
                @RenderBody()
            </main>

            <!-- FOOTER -->
            <footer class="dashboard-footer">
                © @DateTime.Now.Year Student Management
                · ASP.NET Core MVC · BTH5
            </footer>

        </div>
    </div>

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

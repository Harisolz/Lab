@model IEnumerable<BTH4.Models.Learner>

@{
    ViewData["Title"] = "Danh sách người học";
    int stt = 1;
}

<div class="container-fluid py-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between
        align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Quản lý người học
            </h2>
            <p class="text-muted mb-0">
                Danh sách người học trong hệ thống
            </p>
        </div>

        <a asp-controller="Learner"
           asp-action="Create"
           class="btn btn-primary">
            + Thêm người học
        </a>
    </div>

    <!-- Thông báo thành công -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success
            alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Thông báo lỗi -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger
            alert-dismissible fade show">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <!-- Thống kê -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-muted">
                Tổng số người học
            </h6>

            <h2 class="fw-bold text-primary mb-0">
                @Model.Count()
            </h2>
        </div>
    </div>

    <!-- Bảng dữ liệu -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Danh sách người học
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover
                    align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">STT</th>
                            <th>ID</th>
                            <th>Họ và tên</th>
                            <th>Ngày nhập học</th>
                            <th>Ngành học</th>
                            <th class="text-center">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        @stt
                                    </td>

                                    <td>
                                        @item.LearnerID
                                    </td>

                                    <td class="fw-semibold">
                                        @item.LastName
                                        @item.FirstMidName
                                    </td>

                                    <td>
                                        @item.EnrollmentDate
                                        .ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-info text-dark">
                                            @(item.Major?.MajorName
                                                ?? "Chưa có ngành")
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <a asp-controller="Learner"
                                           asp-action="Edit"
                                           asp-route-id="@item.LearnerID"
                                           class="btn btn-outline-warning btn-sm">
                                            Sửa
                                        </a>

                                        <a asp-controller="Learner"
                                           asp-action="Delete"
                                           asp-route-id="@item.LearnerID"
                                           class="btn btn-outline-danger btn-sm">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center py-5 text-muted">
                                    Chưa có người học nào.
                                    Hãy thêm người học mới!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

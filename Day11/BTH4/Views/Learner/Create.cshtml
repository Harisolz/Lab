@model BTH4.Models.Learner

@{
    ViewData["Title"] = "Thêm người học";
}

<div class="container mt-4">
    <h2 class="mb-4">Thêm người học</h2>

    <form asp-controller="Learner"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="LastName" class="form-label">
                Họ
            </label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FirstMidName" class="form-label">
                Tên đệm và tên
            </label>
            <input asp-for="FirstMidName" class="form-control" />
            <span asp-validation-for="FirstMidName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EnrollmentDate" class="form-label">
                Ngày nhập học
            </label>
            <input asp-for="EnrollmentDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="EnrollmentDate"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MajorID" class="form-label">
                Ngành học
            </label>
            <select asp-for="MajorID"
                    asp-items="ViewBag.Majors"
                    class="form-select">
                <option value="">-- Chọn ngành học --</option>
            </select>
            <span asp-validation-for="MajorID"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Lưu người học
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

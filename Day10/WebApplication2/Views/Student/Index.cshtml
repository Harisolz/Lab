@model IEnumerable<MyWebApp.Models.Student>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2 class="mb-4">DANH SÁCH SINH VIÊN</h2>

<!-- Cách 1: HTML thuần, sử dụng href -->
<a href="/Admin/Student/Add"
   class="btn btn-primary mb-3">
    Create Student - HTML
</a>

<!-- Cách 2: Tag Helper, sử dụng asp-action -->
<a asp-controller="Student"
   asp-action="Create"
   class="btn btn-outline-primary mb-3">
    Create Student - asp-action
</a>

<!-- Cách 3: Tag Helper, sử dụng asp-route -->
<a asp-route="student-add"
   class="btn btn-outline-success mb-3">
    Create Student - asp-route
</a>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Ảnh đại diện</th>
                <th>Họ tên</th>
                <th>Ngày sinh</th>
                <th>Ngành học</th>
                <th>Giới tính</th>
                <th>Hệ đào tạo</th>
                <th>Địa chỉ</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <!-- ID -->
                    <td>@student.Id</td>

                    <!-- Ảnh đại diện -->
                    <td>
                        @if (!string.IsNullOrEmpty(student.ImagePath))
                        {
                            <img src="@student.ImagePath"
                                 alt="Ảnh của sinh viên"
                                 class="student-avatar"
                                 width="80"
                                 height="80"
                                 style="object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted">
                                Chưa có ảnh
                            </span>
                        }
                    </td>

                    <!-- Họ tên -->
                    <td>@student.Name</td>

                    <!-- Ngày sinh -->
                    <td>
                        @student.DateOfBirth.ToString("dd/MM/yyyy")
                    </td>

                    <!-- Ngành học -->
                    <td>
                        @{
                            string branchName = student.Branch switch
                            {
                                MyWebApp.Models.Branch.IT => "CNTT",
                                MyWebApp.Models.Branch.BE => "Kinh tế",
                                MyWebApp.Models.Branch.CE => "Công trình",
                                MyWebApp.Models.Branch.EE => "Điện, điện tử",
                                _ => "Chưa chọn"
                            };
                        }

                        @branchName
                    </td>

                    <!-- Giới tính -->
                    <td>
                        @if (student.Gender == MyWebApp.Models.Gender.Male)
                        {
                            <span>Nam</span>
                        }
                        else if (student.Gender == MyWebApp.Models.Gender.Female)
                        {
                            <span>Nữ</span>
                        }
                        else
                        {
                            <span>Chưa chọn</span>
                        }
                    </td>

                    <!-- Hệ đào tạo -->
                    <td>
                        @(student.IsRegular
                            ? "Chính quy"
                            : "Phi chính quy")
                    </td>

                    <!-- Địa chỉ -->
                    <td>@student.Address</td>

                    <!-- Email -->
                    <td>@student.Email</td>
                </tr>
            }
        </tbody>

    </table>
</div>

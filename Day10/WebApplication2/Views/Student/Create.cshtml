@model MyWebApp.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h2 class="mb-4">THÊM SINH VIÊN</h2>

<!--
    Câu 8 - Cách 1:
    HTML thuần sử dụng action trỏ trực tiếp tới URL POST.

    enctype="multipart/form-data" cần thiết cho upload ảnh.
-->
<form action="/Admin/Student/Add/Submit"
      method="post"
      enctype="multipart/form-data"
      class="student-form">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <!-- Họ tên -->
    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Họ tên
        </label>

        <input asp-for="Name"
               class="form-control"
               required />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <!-- Email -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label">
            Email
        </label>

        <input asp-for="Email"
               type="email"
               class="form-control"
               required />

        <span asp-validation-for="Email"
              class="text-danger"></span>
    </div>

    <!-- Mật khẩu -->
    <div class="mb-3">
        <label asp-for="Password" class="form-label">
            Mật khẩu
        </label>

        <input asp-for="Password"
               type="password"
               class="form-control"
               required />

        <span asp-validation-for="Password"
              class="text-danger"></span>
    </div>

    <!-- Ngành học -->
    <div class="mb-3">
        <label asp-for="Branch" class="form-label">
            Ngành học
        </label>

        <select asp-for="Branch"
                class="form-select"
                required>
            <option value="">-- Chọn ngành học --</option>
            <option value="IT">IT - Công nghệ thông tin</option>
            <option value="BE">BE - Kinh tế</option>
            <option value="CE">CE - Công trình</option>
            <option value="EE">EE - Điện, điện tử</option>
        </select>

        <span asp-validation-for="Branch"
              class="text-danger"></span>
    </div>

    <!-- Giới tính -->
    <div class="mb-3">
        <label class="form-label d-block">
            Giới tính
        </label>

        <div class="form-check form-check-inline">
            <input asp-for="Gender"
                   type="radio"
                   value="Male"
                   id="genderMale"
                   class="form-check-input"
                   required />

            <label for="genderMale"
                   class="form-check-label">
                Nam
            </label>
        </div>

        <div class="form-check form-check-inline">
            <input asp-for="Gender"
                   type="radio"
                   value="Female"
                   id="genderFemale"
                   class="form-check-input" />

            <label for="genderFemale"
                   class="form-check-label">
                Nữ
            </label>
        </div>

        <span asp-validation-for="Gender"
              class="text-danger d-block"></span>
    </div>

    <!-- Hệ đào tạo -->
    <div class="mb-3">
        <label class="form-label d-block">
            Hệ đào tạo
        </label>

        <div class="form-check form-check-inline">
            <input asp-for="IsRegular"
                   type="radio"
                   value="true"
                   id="regular"
                   class="form-check-input"
                   checked />

            <label for="regular"
                   class="form-check-label">
                Chính quy
            </label>
        </div>

        <div class="form-check form-check-inline">
            <input asp-for="IsRegular"
                   type="radio"
                   value="false"
                   id="nonRegular"
                   class="form-check-input" />

            <label for="nonRegular"
                   class="form-check-label">
                Phi chính quy
            </label>
        </div>
    </div>

    <!-- Địa chỉ -->
    <div class="mb-3">
        <label asp-for="Address" class="form-label">
            Địa chỉ
        </label>

        <textarea asp-for="Address"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <!-- Ngày sinh -->
    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label">
            Ngày sinh
        </label>

        <input asp-for="DateOfBirth"
               type="date"
               class="form-control"
               required />

        <span asp-validation-for="DateOfBirth"
              class="text-danger"></span>
    </div>

    <!-- Câu 9: upload ảnh đại diện -->
    <div class="mb-3">
        <label for="imageFile" class="form-label">
            Ảnh đại diện
        </label>

        <input type="file"
               id="imageFile"
               name="imageFile"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp" />

        <div class="form-text">
            Chọn ảnh JPG, JPEG, PNG hoặc WEBP.
            Dung lượng tối đa 5 MB.
        </div>

        <span class="text-danger">
            @Html.ValidationMessage("imageFile")
        </span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    <a asp-route="student-list"
       class="btn btn-secondary">
        Quay lại danh sách
    </a>
</form>
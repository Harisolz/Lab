@model IEnumerable<BTH2.Models.MenuItem>

<div class="sidebar-inner">

    <a asp-controller="Student"
       asp-action="Index"
       class="sidebar-brand">

        <span class="brand-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </span>

        <span>
            <strong>EduPanel</strong>
            <small>Student Management</small>
        </span>
    </a>

    <div class="sidebar-section-label">WORKSPACE</div>

    <nav class="sidebar-navigation">

        <a asp-controller="Home"
           asp-action="Index"
           class="sidebar-nav-item">
            <i class="bi bi-grid-1x2"></i>
            <span>Dashboard</span>
        </a>

        @foreach (var item in Model)
        {
            string iconClass = item.Name switch
            {
                "Branches" => "bi-building",
                "Students" => "bi-people",
                "Subjects" => "bi-journal-bookmark",
                "Courses" => "bi-book",
                _ => "bi-circle"
            };

            bool isActive = item.Name == "Students";

            <a href="@item.Link"
               class="sidebar-nav-item @(isActive ? "active" : "")">

                <i class="bi @iconClass"></i>

                <span>@item.Name</span>
            </a>
        }
    </nav>

    <div class="sidebar-bottom">
        <div class="sidebar-profile">
            <div class="profile-avatar">AD</div>
            <div>
                <strong>Administrator</strong>
                <small>Quản trị viên</small>
            </div>
            <i class="bi bi-three-dots"></i>
        </div>
    </div>
</div>
